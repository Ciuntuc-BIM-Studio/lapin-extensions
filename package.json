{
  "name": "lapin-extensions",
  "private": true,
  "description": "The catalogue of Lapin Extensions: one manifest per extension, the index built from them, the checks a pull request passes.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tools/lib.test.mjs",
    "validate": "node tools/validate.mjs",
    "validate:local": "node tools/validate.mjs --local",
    "index": "node tools/build-index.mjs",
    "index:local": "node tools/build-index.mjs --local",
    "examples": "node tools/make-examples.mjs"
  }
}
